<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="IndieGames.Pages.StardewValleyDetailPage"
    Title="Detalle">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="{Binding Name}" FontSize="24" FontAttributes="Bold"/>
            <Image Source="{Binding ImageUrl}" HeightRequest="220"/>
            <Label Text="{Binding Date}" FontSize="16" FontAttributes="Italic"/>
            <Label Text="{Binding Details}" FontSize="16"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
