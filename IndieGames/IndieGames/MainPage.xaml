<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="IndieGames.MainPage"
    BackgroundColor="#1e1e2e"
    Title="🎮 Bienvenida">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center" HorizontalOptions="Center">

            <!-- Ícono central -->
            <Image Source="https://images.vexels.com/media/users/3/208298/isolated/preview/288f9cd4b6ae6ed6eaa8a4b3a4bfca65-icono-de-trazo-de-jugador-de-joystick.png" HeightRequest="200" WidthRequest="200" HorizontalOptions="Center"/>

            <Label Text="IndieGamesApp"
                   FontSize="36"
                   FontAttributes="Bold"
                   TextColor="#cba6f7"
                   HorizontalOptions="Center" />

            <Label Text="Explora mundos únicos y memorables:"
                   FontSize="20"
                   TextColor="White"
                   HorizontalTextAlignment="Center"/>

            <!-- Nombres con estilo retro -->
            <Label Text="🌑 Hollow Knight     ❄ Celeste     🌾 Stardew Valley     🔥 Hades     💛 Undertale"
                   FontSize="16"
                   TextColor="#89b4fa"
                   FontAttributes="Italic"
                   HorizontalTextAlignment="Center" />

            <!-- Indicador -->
            <Label Text="Abre el menú lateral ☰ para comenzar tu aventura"
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
