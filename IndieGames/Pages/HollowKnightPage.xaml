<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:IndieGames.Models"
             x:Class="IndieGames.Pages.HollowKnightPage"
             Title="Hollow Knight">

    <CollectionView x:Name="GamesCollection"
                    Margin="10"
                    SelectionMode="Single"
                    SelectionChanged="OnSelectionChanged">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="model:Game">
                <Frame Padding="10" CornerRadius="12" Margin="5" BorderColor="Gray">
                    <VerticalStackLayout>
                        <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold"/>
                        <Image Source="{Binding ImageUrl}" HeightRequest="180"/>
                        <Label Text="{Binding Date}" FontSize="14" FontAttributes="Italic"/>
                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
